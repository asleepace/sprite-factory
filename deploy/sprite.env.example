# /etc/sprite/sprite.env  (owner root:sprite, mode 0640)
SPRITE_BIND=127.0.0.1:8787
SPRITE_LIBRARY=/var/lib/sprite/library
SPRITE_TOKENS_FILE=/etc/sprite/tokens
# public hostname(s) the MCP endpoint accepts (nginx forwards the Host header)
SPRITE_HOSTS=sprites.asleepace.com
# browser origins allowed to fetch from the API, comma-separated (prototype dev servers)
#SPRITE_CORS=http://localhost:5173,http://localhost:8080
# optional: lets blind_review call Claude directly (set a spend limit on this key)
#ANTHROPIC_API_KEY=
#SPRITE_REVIEW_MODEL=claude-sonnet-5-5
